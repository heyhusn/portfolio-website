# ─── Dependencies ────────────────────────────────────────────────────────
node_modules/
backend/node_modules/
.pnp
.pnp.js

# ─── Build output ────────────────────────────────────────────────────────
# Vercel builds from source on every deploy; a committed dist/ only ever goes
# stale and creates merge noise.
dist/
build/
.vite/
*.tsbuildinfo

# ─── Secrets ─────────────────────────────────────────────────────────────
# backend/.env holds the LLM API key and the JWT secret. In production those
# live in Vercel → Settings → Environment Variables, never in the repo.
.env
.env.*
!.env.example

# ─── Local database ──────────────────────────────────────────────────────
# The admin CMS's SQLite file. It holds real content and a bcrypt password
# hash, and is rebuilt locally with `npm run seed` in backend/.
backend/portfolio.db
backend/portfolio.db-shm
backend/portfolio.db-wal
*.sqlite
*.sqlite3

# ─── Generated at install time ───────────────────────────────────────────
# Draco / KTX2 decoder binaries, copied out of the `three` package by the
# postinstall script. Vercel runs postinstall, so they are recreated on every
# deploy — committing ~1 MB of binaries that regenerate themselves is waste.
public/decoders/

# ─── Large local media ───────────────────────────────────────────────────
# Reference recording of the original Framer template, ~21 MB. Useful on the
# desktop, pointless in a clone.
portfolio.mp4
*.mov
*.avi

# ─── Tooling & platform ──────────────────────────────────────────────────
.vercel
.netlify
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
coverage/
.nyc_output/
test-results/
playwright-report/

# ─── Editors & OS ────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ─── Scratch ─────────────────────────────────────────────────────────────
_to_delete/
*.tgz
*.tmp
tmp/

# ─────────────────────────────────────────────────────────────────────────
# NOT ignored, deliberately — read before adding anything here:
#
#   api/_rag-index.js      Generated by `npm run export:index`, and it LOOKS
#                          like a build artefact. It is not: Vercel has no
#                          database, so this file *is* the chatbot's knowledge
#                          base in production. Ignoring it ships a deployed
#                          assistant with nothing to retrieve.
#
#   backend/rag/sources/   The corpus the index is built from — resumes,
#                          LinkedIn, GitHub READMEs. Needed to rebuild it.
#
#   public/assets/         Self-hosted fonts, images and the CV PDF. The site
#                          makes no third-party requests for these by design.
# ─────────────────────────────────────────────────────────────────────────
