# Copy this file to backend/.env and fill in real values before running the
# admin API anywhere other than your own machine. backend/.env is gitignored.

# Long random string used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomUUID()+require('crypto').randomUUID())"
JWT_SECRET=

# Comma-separated list of origins allowed to call this API. The Vite dev
# server runs on 5173; add your deployed frontend's origin(s) too, e.g.
# CORS_ORIGIN=http://localhost:5173,https://husnainaslam.com
CORS_ORIGIN=http://localhost:5173

# Port the API listens on.
PORT=3001

# Password for the default "admin" user created by `npm run seed`.
# Change this — the fallback (admin123) is public in this repo's history.
SEED_ADMIN_PASSWORD=

# Optional. A GitHub personal access token with NO scopes ticked is enough.
# With it, /api/github/:username uses the official GraphQL contributions API
# (exact counts) and gets 5,000 REST calls/hour instead of 60. Without it the
# route still works — it parses the same calendar GitHub renders on the
# public profile page.
GITHUB_TOKEN=

# --- RAG assistant -------------------------------------------------------
# Any OpenAI-compatible chat endpoint. Defaults target DeepSeek; OpenAI, Groq,
# OpenRouter, Together and a local Ollama all speak the same shape.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_MS=45000

# Questions allowed per IP per 10 minutes. Each one is a real, paid API call,
# so this is the throttle between a public portfolio and a surprise bill.
RAG_RATE_LIMIT=25

# NOTE FOR PRODUCTION
# In production the chatbot does NOT run through this Express server — it runs
# as Vercel functions in api/rag/, which read the same variables from Vercel's
# own environment settings. Set LLM_API_KEY (and LLM_BASE_URL / LLM_MODEL if
# you are not on DeepSeek) in the Vercel dashboard under Settings →
# Environment Variables. This file is for local development only, and is
# gitignored — the key must never reach the repo or the browser bundle.

# --- Database ------------------------------------------------------------
# Unset  → SQLite at backend/portfolio.db. Zero setup, right for local work.
# Set    → Postgres. Required in production: Vercel's filesystem is ephemeral,
#          so anything written to a local SQLite file there survives only
#          until the instance recycles.
#
# Supabase → Project Settings → Database → Connection string → URI.
# Use the *connection pooler* URI (port 6543), not the direct one (5432):
# every serverless instance opens its own connection, and Postgres runs out
# of them long before Vercel runs out of instances.
#
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# In production JWT_SECRET is required, not optional. The local server falls
# back to a random per-boot secret; serverless instances would each generate
# their own, so an admin token would validate or not depending on which
# instance answered.
